<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:m="using:BlackSharp.UI.Avalonia.TreeDataGrid.Demo.Models"
        xmlns:vm="using:BlackSharp.UI.Avalonia.TreeDataGrid.Demo.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="BlackSharp.UI.Avalonia.TreeDataGrid.Demo.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TreeDataGrid — v12 features"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="DragDropPreviewTemplate"
                      x:DataType="m:DragDropItem">
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    Padding="12,8">
                <StackPanel Spacing="3">
                    <TextBlock Text="Moving item"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Name}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <TabControl Name="tabs">
        <TabItem Header="v12 Features">
            <DockPanel Margin="12">
                <TextBlock Text="{Binding Features.Status}"
                           TextWrapping="Wrap"
                           Margin="0 8"
                           DockPanel.Dock="Bottom"/>
                <TextBlock Classes="realized-count"
                           DockPanel.Dock="Bottom"/>
                <WrapPanel DockPanel.Dock="Top"
                           Margin="0 0 0 8">
                    <TextBox Text="{Binding Features.Filter}"
                             PlaceholderText="Filter names (parents retained by the demo predicate)"
                             Width="350"
                             Margin="0 0 8 8"/>
                    <Button Content="Refresh filter"
                            Command="{Binding Features.RefreshFilter}"
                            Margin="0 0 8 8"/>
                    <Button Content="Expand all"
                            Command="{Binding Features.ExpandAll}"
                            Margin="0 0 8 8"/>
                    <Button Content="Collapse all"
                            Command="{Binding Features.CollapseAll}"
                            Margin="0 0 8 8"/>
                    <Button Content="Clear sort"
                            Command="{Binding Features.ClearSort}"
                            Margin="0 0 8 8"/>
                    <Button Content="Select all"
                            Command="{Binding Features.SelectAll}"
                            Margin="0 0 8 8"/>
                    <CheckBox Content="Drawn text"
                              IsChecked="{Binding Features.DrawnCells}"
                              Margin="0 0 12 8"/>
                    <CheckBox Content="Cell selection"
                              IsChecked="{Binding Features.CellSelection}"
                              Margin="0 0 12 8"/>
                    <CheckBox Content="Double-tap expansion"
                              IsChecked="{Binding #features.ExpandCollapseOnDoubleTap, Mode=TwoWay}"
                              Margin="0 0 12 8"/>
                    <CheckBox Content="Left arrow to parent"
                              IsChecked="{Binding #features.SelectParentOnLeftArrow, Mode=TwoWay}"
                              Margin="0 0 12 8"/>
                    <CheckBox Content="Ctrl+arrows scroll"
                              IsChecked="{Binding #features.PreserveSelectionOnCtrlArrowScroll, Mode=TwoWay}"
                              Margin="0 0 12 8"/>
                    <TextBlock Text="Frozen columns"
                               VerticalAlignment="Center"
                               Margin="0 0 8 8"/>
                    <NumericUpDown Value="{Binding Features.FrozenColumns}"
                                   Minimum="0"
                                   Maximum="5"
                                   Width="100"
                                   Margin="0 0 8 8"/>
                    <Button Content="Change offscreen expansion"
                            Command="{Binding Features.ChangeOffscreenExpansion}"
                            Margin="0 0 8 8"/>
                </WrapPanel>
                <TreeDataGrid Name="features"
                              Source="{Binding Features.Source}"
                              GridLinesVisibility="All"
                              ColumnReordered="Features_ColumnReordered">
                    <TreeDataGrid.Resources>
                        <DataTemplate x:Key="FeatureCategoryCell"
                                      x:DataType="m:ShowcaseRow">
                            <TextBlock Text="{Binding Category}"/>
                        </DataTemplate>
                        <DataTemplate x:Key="FeatureCategoryEdit"
                                      x:DataType="m:ShowcaseRow">
                            <ComboBox ItemsSource="{x:Static m:ShowcaseRow.Categories}"
                                      SelectedItem="{Binding Category, Mode=TwoWay}"/>
                        </DataTemplate>
                    </TreeDataGrid.Resources>
                </TreeDataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="XAML columns">
            <DockPanel Margin="12">
                <TextBlock Text="ItemsSource, columns and standard compiled bindings are defined in XAML. The first two columns are frozen."
                           TextWrapping="Wrap"
                           Margin="0 0 0 8"
                           DockPanel.Dock="Top"/>
                <TextBlock Classes="realized-count"
                           DockPanel.Dock="Bottom"/>
                <TreeDataGrid Name="xamlFeatures"
                              ItemsSource="{Binding Features.Items}"
                              FrozenColumnCount="2"
                              CanUserReorderColumns="True"
                              AllowTriStateSorting="True"
                              SelectionMode="Row, Multiple"
                              GridLinesVisibility="All">
                    <TreeDataGrid.Columns>
                        <TreeDataGridRowHeaderColumn Header="#"/>
                        <TreeDataGridHierarchicalExpanderColumn x:DataType="m:ShowcaseRow"
                                                                Header="Name"
                                                                Width="260"
                                                                ChildrenBinding="{CompiledBinding Children}"
                                                                IsExpandedBinding="{CompiledBinding Expanded, Mode=TwoWay}">
                            <TreeDataGridHierarchicalExpanderColumn.Inner>
                                <TreeDataGridTextColumn Binding="{CompiledBinding Name, Mode=TwoWay}"
                                                        UseDrawnCells="True"/>
                            </TreeDataGridHierarchicalExpanderColumn.Inner>
                        </TreeDataGridHierarchicalExpanderColumn>
                        <TreeDataGridCheckBoxColumn x:DataType="m:ShowcaseRow"
                                                    Header="Enabled"
                                                    Binding="{CompiledBinding Enabled, Mode=TwoWay}"/>
                        <TreeDataGridCheckBoxColumn x:DataType="m:ShowcaseRow"
                                                    Header="Checked"
                                                    IsThreeState="True"
                                                    Binding="{CompiledBinding Checked, Mode=TwoWay}"/>
                        <TreeDataGridTextColumn x:DataType="m:ShowcaseRow"
                                                Header="Temperature"
                                                Width="160"
                                                Binding="{CompiledBinding Temperature, Mode=TwoWay}"/>
                        <TreeDataGridTextColumn x:DataType="m:ShowcaseRow"
                                                Header="Category"
                                                Width="200"
                                                Binding="{CompiledBinding Category}"
                                                IsReadOnly="True"/>
                    </TreeDataGrid.Columns>
                </TreeDataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Countries">
            <DockPanel>
                <TextBlock Classes="realized-count"
                           DockPanel.Dock="Bottom"/>
                <StackPanel DockPanel.Dock="Right"
                            Spacing="4"
                            Margin="4 0 0 0">
                    <CheckBox IsChecked="{Binding Countries.CellSelection}">Cell Selection</CheckBox>
                    <Label Target="countryTextBox">_Country</Label>
                    <TextBox Name="countryTextBox">Sealand</TextBox>
                    <Label Target="regionTextBox">_Region</Label>
                    <TextBox Name="regionTextBox">WESTERN EUROPE</TextBox>
                    <Label Target="populationTextBox">_Population</Label>
                    <TextBox Name="populationTextBox">2</TextBox>
                    <Label Target="areaTextBox">_Area</Label>
                    <TextBox Name="areaTextBox">0.004</TextBox>
                    <Label Target="gdpTextBox">_GDP</Label>
                    <TextBox Name="gdpTextBox">600000</TextBox>
                    <Button Click="AddCountryClick">Add</Button>
                    <Button Command="{Binding Countries.RemoveSelected}">Remove</Button>
                </StackPanel>
                <DropDownButton Content="Columns Visibility"
                                DockPanel.Dock="Top">
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <ItemsControl ItemsSource="{Binding #countries.Columns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsVisible}"
                                                  Content="{Binding Header,FallbackValue=none}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <TreeDataGrid Name="countries"
                              Source="{Binding Countries.Source}"
                              AutoDragDropRows="True">
                    <TreeDataGrid.Resources>
                        <!-- Template for Region column cells -->
                        <DataTemplate x:Key="RegionCell"
                                      DataType="m:Country">
                            <TextBlock Text="{Binding Region}"/>
                        </DataTemplate>
                        <DataTemplate x:Key="RegionEditCell"
                                      DataType="m:Country">
                            <ComboBox ItemsSource="{x:Static m:Countries.Regions}"
                                      SelectedItem="{Binding Region}"/>
                        </DataTemplate>

                    </TreeDataGrid.Resources>
                    <TreeDataGrid.Styles>
                        <Style Selector="TreeDataGrid TreeDataGridRow:nth-last-child(2n)">
                            <Setter Property="Background"
                                    Value="#20808080"/>
                        </Style>
                        <Style Selector="TreeDataGrid :is(TreeDataGridCell):nth-last-child(1)">
                            <Setter Property="TextBlock.FontWeight"
                                    Value="Bold"/>
                        </Style>
                        <Style Selector="TreeDataGrid TreeDataGridColumnHeader:nth-last-child(1)">
                            <Setter Property="TextBlock.FontWeight"
                                    Value="Bold"/>
                        </Style>
                    </TreeDataGrid.Styles>
                </TreeDataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Files">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top"
                           Margin="0 4">
                    <ComboBox ItemsSource="{Binding Files.Drives}"
                              SelectedItem="{Binding Files.SelectedDrive}"
                              DockPanel.Dock="Left"/>
                    <CheckBox IsChecked="{Binding Files.CellSelection}"
                              Margin="4 0 0 0"
                              DockPanel.Dock="Right">
                        Cell Selection
                    </CheckBox>
                    <CheckBox IsChecked="{Binding Files.FlatList}"
                              Margin="4 0 0 0"
                              DockPanel.Dock="Right">
                        Flat
                    </CheckBox>
                    <TextBox Text="{Binding Files.SelectedPath, Mode=OneWay}"
                             Margin="4 0 0 0"
                             VerticalContentAlignment="Center"
                             KeyDown="SelectedPath_KeyDown"/>
                </DockPanel>
                <TextBlock Classes="realized-count"
                           DockPanel.Dock="Bottom"/>
                <TreeDataGrid Name="fileViewer"
                              Source="{Binding Files.Source}">
                    <TreeDataGrid.Resources>

                        <!-- Template for Name column cells -->
                        <DataTemplate x:Key="FileNameCell"
                                      DataType="m:FileTreeNodeModel">
                            <StackPanel Orientation="Horizontal">
                                <Image Margin="0 0 4 0"
                                       VerticalAlignment="Center">
                                    <Image.Source>
                                        <MultiBinding Converter="{x:Static vm:FilesPageViewModel.FileIconConverter}">
                                            <Binding Path="IsDirectory"/>
                                            <Binding Path="IsExpanded"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>

                        <!-- Edit template for Name column cells -->
                        <DataTemplate x:Key="FileNameEditCell"
                                      DataType="m:FileTreeNodeModel">
                            <StackPanel Orientation="Horizontal">
                                <Image Margin="0 0 4 0"
                                       VerticalAlignment="Center">
                                    <Image.Source>
                                        <MultiBinding Converter="{x:Static vm:FilesPageViewModel.FileIconConverter}">
                                            <Binding Path="IsDirectory"/>
                                            <Binding Path="IsExpanded"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                                <TextBox Text="{Binding Name}"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>

                    </TreeDataGrid.Resources>
                    <TreeDataGrid.Styles>
                        <Style Selector="TreeDataGrid TreeDataGridRow:nth-child(2n)">
                            <Setter Property="Background"
                                    Value="#20808080"/>
                        </Style>
                    </TreeDataGrid.Styles>
                </TreeDataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Wikipedia">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0 4">
                    <Button Content="Reload"
                            Command="{Binding Wikipedia.Reload}"
                            Margin="0 0 8 0"/>
                    <TextBlock Text="{Binding Wikipedia.Status}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Classes="realized-count"
                           DockPanel.Dock="Bottom"/>
                <TreeDataGrid Name="wikipedia"
                              Source="{Binding Wikipedia.Source}">
                    <TreeDataGrid.Resources>
                        <DataTemplate x:Key="WikipediaImageCell"
                                      DataType="m:OnThisDayArticle">
                            <Image Source="{Binding Image^}"/>
                        </DataTemplate>
                    </TreeDataGrid.Resources>
                </TreeDataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Drag/Drop">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="8"
                            Spacing="6">
                    <CheckBox Name="customDragPreview"
                              Content="Use a custom drag preview template"/>
                    <TextBlock Text="Drag a row to see its snapshot. The checkbox replaces it with a template bound to the dragged item."
                               TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Classes="realized-count"
                           DockPanel.Dock="Bottom"/>
                <TreeDataGrid Name="dragDrop"
                              Source="{Binding DragDrop.Source}"
                              AutoDragDropRows="True"
                              RowDragStarted="DragDrop_RowDragStarted"
                              RowDragOver="DragDrop_RowDragOver"
                              Classes.custom-drag-preview="{Binding #customDragPreview.IsChecked}">
                    <TreeDataGrid.Styles>
                        <Style Selector="TreeDataGrid.custom-drag-preview">
                            <Setter Property="DragPreviewTemplate"
                                    Value="{StaticResource DragDropPreviewTemplate}"/>
                        </Style>
                    </TreeDataGrid.Styles>
                </TreeDataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Dynamic">
            <DockPanel>
                <TextBlock Classes="realized-count"
                           DockPanel.Dock="Bottom"/>
                <StackPanel DockPanel.Dock="Top"
                            Spacing="4"
                            Margin="4 2"
                            Orientation="Horizontal">
                    <Label Target="dynamicSizeTextBox">Column count</Label>
                    <TextBox Name="dynamicSizeTextBox"
                             Text="{Binding Dynamic.ColumnCount, Delay=300}"/>
                </StackPanel>
                <TreeDataGrid Source="{Binding Dynamic.Source}">
                    <TreeDataGrid.Resources>
                        <DataTemplate x:Key="DynamicCell"
                                      DataType="m:DataCell">
                            <TextBlock Text="{Binding Value}"/>
                        </DataTemplate>
                        <DataTemplate x:Key="DynamicEditingCell"
                                      DataType="m:DataCell">
                            <TextBox Text="{Binding Value}"/>
                        </DataTemplate>
                    </TreeDataGrid.Resources>
                </TreeDataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
